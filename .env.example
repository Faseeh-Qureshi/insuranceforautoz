# ==============================================================================
# InsuranceforAutoz.com - Vite & Cloudflare Pages Environment Configuration
# Copy to .env for local overrides, or set in Cloudflare Pages -> Settings -> Environment variables.
# Note: All VITE_* variables are embedded into the static client bundle at build time.
# Never place private API keys or secrets in VITE_* variables.
# ==============================================================================

# Canonical site origin (without trailing slash)
VITE_SITE_URL="https://insuranceforautoz.com"

# Inbound call destination in E.164 format (automatically formats display text and tel: links)
VITE_CALL_PHONE_E164="+18484671057"

# Mailing address displayed in footer and legal disclosure modal
VITE_COMPANY_ADDRESS_LINE1="7901 4th St N STE 300"
VITE_COMPANY_ADDRESS_LINE2="St. Petersburg, FL 33702"

# Optional standalone legal URLs (leave empty to serve the built-in disclosure modal)
VITE_PRIVACY_POLICY_URL=""
VITE_TERMS_OF_USE_URL=""

# Platform runtime placeholders (unused by the static Vite build)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="https://insuranceforautoz.com"
